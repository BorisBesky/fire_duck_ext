{
    "name": "fire-duck-ext",
    "version-string": "0.1.1",
    "description": "DuckDB extension for Google Cloud Firestore",
    "dependencies": [
        {
            "name": "openssl",
            "platform": "!emscripten"
        },
        {
            "name": "zlib",
            "platform": "!emscripten"
        }
    ],
    "vcpkg-configuration": {
        "overlay-ports": [
            "./extension-ci-tools/vcpkg_ports"
        ],
        "overlay-triplets": [
            "./extension-ci-tools/toolchains"
        ]
    }
}
