# name: test/sql/firestore_write.test
# description: Test Firestore write operations (UPDATE, DELETE, batch)
# group: [sql]

require fire_duck_ext

# ============================================
# firestore_update Error Handling
# ============================================

# Missing credentials
statement error
SELECT * FROM firestore_update('users', 'doc1', 'name', 'New Name');
----
No Firestore credentials found

# Create secret for further tests
statement ok
CREATE SECRET write_test (
    TYPE firestore,
    PROJECT_ID 'test-project',
    API_KEY 'test-key'
);

# Missing field/value pairs (only collection and doc_id)
statement error
SELECT * FROM firestore_update('users', 'doc1');
----
firestore_update requires at least one field to update

# Odd number of field/value args (missing value)
statement error
SELECT * FROM firestore_update('users', 'doc1', 'name');
----
firestore_update requires field name/value pairs

# Field name must be a string
statement error
SELECT * FROM firestore_update('users', 'doc1', 123, 'value');
----
must be a string

# ============================================
# firestore_delete Error Handling
# ============================================

statement ok
DROP SECRET write_test;

# Missing credentials
statement error
SELECT * FROM firestore_delete('users', 'doc1');
----
No Firestore credentials found

# ============================================
# firestore_update_batch Error Handling
# ============================================

# Non-list document IDs (string instead of list) — DuckDB rejects before bind (1.5: no overload; 2.0: failed cast)
statement error
SELECT * FROM firestore_update_batch('users', 'not-a-list', 'field', 'value');
----
<REGEX>:.*(No function matches|can't be cast to the destination type VARCHAR\[\]).*

# Empty field list after document IDs
statement error
SELECT * FROM firestore_update_batch('users', ['id1', 'id2']);
----
firestore_update_batch requires at least one field to update

# Odd number of field/value args
statement error
SELECT * FROM firestore_update_batch('users', ['id1'], 'field');
----
firestore_update_batch requires field name/value pairs

# ============================================
# firestore_delete_batch Error Handling
# ============================================

# Non-list document IDs — DuckDB rejects at type check before bind
statement error
SELECT * FROM firestore_delete_batch('users', 'not-a-list');
----
<REGEX>:.*(No function matches|can't be cast to the destination type VARCHAR\[\]).*

# ============================================
# Function Signature Validation
# ============================================

# firestore_update requires at least 4 arguments (collection, doc_id, field, value)
statement error
SELECT * FROM firestore_update('users');
----

# firestore_delete requires exactly 2 arguments
statement error
SELECT * FROM firestore_delete('users');
----

# ============================================
# Type Coercion Tests
# ============================================

statement ok
CREATE SECRET type_test (
    TYPE firestore,
    PROJECT_ID 'test-project',
    API_KEY 'test-key'
);

# Different value types should be accepted
# (These will fail at runtime due to invalid credentials, but bind should succeed)

# String value
statement error
SELECT * FROM firestore_update('users', 'doc1', 'name', 'string_value');
----

# Integer value
statement error
SELECT * FROM firestore_update('users', 'doc1', 'age', 42);
----

# Boolean value
statement error
SELECT * FROM firestore_update('users', 'doc1', 'active', true);
----

# Double value
statement error
SELECT * FROM firestore_update('users', 'doc1', 'score', 3.14);
----

# NULL value
statement error
SELECT * FROM firestore_update('users', 'doc1', 'deleted_field', NULL);
----

# ============================================
# Multi-field Update Tests
# ============================================

# Update multiple fields at once
statement error
SELECT * FROM firestore_update('users', 'doc1', 'name', 'Alice', 'age', 30, 'active', true);
----

# Update with mixed types
statement error
SELECT * FROM firestore_update('products', 'prod1', 'name', 'Widget', 'price', 9.99, 'inStock', true, 'quantity', 100);
----

# ============================================
# Nested Collection Path Tests
# ============================================

# Update document in nested collection
statement error
SELECT * FROM firestore_update('users/user1/orders', 'order1', 'status', 'shipped');
----

# Delete from nested collection
statement error
SELECT * FROM firestore_delete('users/user1/orders', 'order1');
----

# Batch update in nested collection
statement error
SELECT * FROM firestore_update_batch('users/user1/orders', ['order1', 'order2'], 'status', 'cancelled');
----

# Batch delete from nested collection
statement error
SELECT * FROM firestore_delete_batch('users/user1/orders', ['order1', 'order2']);
----

# ============================================
# Named Parameter Tests
# ============================================

# Update with explicit project_id
statement error
SELECT * FROM firestore_update('users', 'doc1', 'name', 'Test', project_id='other-project');
----

# Update with custom database
statement error
SELECT * FROM firestore_update('users', 'doc1', 'name', 'Test', database='custom-db');
----

# Delete with explicit credentials path
statement error
SELECT * FROM firestore_delete('users', 'doc1', credentials='/nonexistent/path.json');
----

# ============================================
# Collection Group Paths (for batch operations)
# ============================================

# Batch update with full document paths (for collection group results)
statement error
SELECT * FROM firestore_update_batch(
    'users',
    ['users/user1/profile/main', 'users/user2/profile/main'],
    'updated', true
);
----

# Batch delete with full document paths
statement error
SELECT * FROM firestore_delete_batch(
    'users',
    ['users/user1/profile/main', 'users/user2/profile/main']
);
----

# ============================================
# Collection Group Write Operations (~ prefix)
# Full document paths inside the group pass the bind-time path check
# (these then fail at runtime with fake credentials, not at the check)
# ============================================

# Single update with ~ collection group prefix
statement error
SELECT * FROM firestore_update('~orders', 'users/user1/orders/order1', 'status', 'shipped');
----
<!REGEX>:.*(not a full document path|not in collection group|empty segment|names no collection|is a path).*

# Single delete with ~ collection group prefix
statement error
SELECT * FROM firestore_delete('~orders', 'users/user1/orders/order1');
----
<!REGEX>:.*(not a full document path|not in collection group|empty segment|names no collection|is a path).*

# Batch update with ~ collection group prefix
statement error
SELECT * FROM firestore_update_batch('~orders', ['users/user1/orders/order1', 'users/user2/orders/order1'], 'status', 'cancelled');
----
<!REGEX>:.*(not a full document path|not in collection group|empty segment|names no collection|is a path).*

# Batch delete with ~ collection group prefix
statement error
SELECT * FROM firestore_delete_batch('~orders', ['users/user1/orders/order1', 'users/user2/orders/order1']);
----
<!REGEX>:.*(not a full document path|not in collection group|empty segment|names no collection|is a path).*

# Array union with ~ collection group prefix
statement error
SELECT * FROM firestore_array_union('~orders', 'users/user1/orders/order1', 'tags', ['urgent']);
----
<!REGEX>:.*(not a full document path|not in collection group|empty segment|names no collection|is a path).*

# Array remove with ~ collection group prefix
statement error
SELECT * FROM firestore_array_remove('~orders', 'users/user1/orders/order1', 'tags', ['urgent']);
----
<!REGEX>:.*(not a full document path|not in collection group|empty segment|names no collection|is a path).*

# Array append with ~ collection group prefix
statement error
SELECT * FROM firestore_array_append('~orders', 'users/user1/orders/order1', 'tags', ['urgent']);
----
<!REGEX>:.*(not a full document path|not in collection group|empty segment|names no collection|is a path).*

# A leading slash is accepted, and a root-level collection named like the
# group is part of the group
statement error
SELECT * FROM firestore_update('~orders', '/users/user1/orders/order1', 'status', 'shipped');
----
<!REGEX>:.*(not a full document path|not in collection group|empty segment|names no collection|is a path).*

statement error
SELECT * FROM firestore_delete('~orders', 'orders/order1');
----
<!REGEX>:.*(not a full document path|not in collection group|empty segment|names no collection|is a path).*

# ============================================
# Collection Group Writes: refused paths
# A collection group has no single parent, so each document must be named by
# its full path inside the group. These fail at bind time, before any request.
# ============================================

# A bare document id names a collection, not a document
statement error
SELECT * FROM firestore_update('~orders', 'order1', 'status', 'shipped');
----
firestore_update: 'order1' is not a full document path; writes to collection group '~orders' need each document's full path, such as '<parent path>/orders/<document id>'

statement error
SELECT * FROM firestore_delete('~orders', 'order1');
----
firestore_delete: 'order1' is not a full document path

# A collection path is not a document either
statement error
SELECT * FROM firestore_delete('~orders', 'users/user1/orders');
----
firestore_delete: 'users/user1/orders' is not a full document path

# A document in another collection is refused rather than written: used
# verbatim, this would delete users/user1
statement error
SELECT * FROM firestore_delete('~orders', 'users/user1');
----
firestore_delete: document 'users/user1' is in collection 'users', not in collection group '~orders'

statement error
SELECT * FROM firestore_update('~orders', 'users/user1/profile/main', 'status', 'shipped');
----
firestore_update: document 'users/user1/profile/main' is in collection 'profile', not in collection group '~orders'

# Collection ids are case-sensitive
statement error
SELECT * FROM firestore_update('~orders', 'users/user1/Orders/order1', 'status', 'shipped');
----
is in collection 'Orders', not in collection group '~orders'

# Empty paths and empty segments
statement error
SELECT * FROM firestore_delete('~orders', '');
----
firestore_delete: document path is empty

statement error
SELECT * FROM firestore_update('~orders', 'users//orders/order1', 'status', 'shipped');
----
firestore_update: document path 'users//orders/order1' has an empty segment

statement error
SELECT * FROM firestore_delete('~orders', 'users/user1/orders/order1/');
----
has an empty segment

# The group must name one collection id
statement error
SELECT * FROM firestore_delete('~', 'users/user1/orders/order1');
----
firestore_delete: collection group '~' names no collection

statement error
SELECT * FROM firestore_update('~users/user1/orders', 'users/user1/orders/order1', 'status', 'shipped');
----
firestore_update: collection group '~users/user1/orders' is a path; a collection group is a single collection id, such as '~orders'

# Batches: one bad path fails the whole statement before any batch is sent
statement error
SELECT * FROM firestore_update_batch('~orders', ['users/user1/orders/order1', 'order2'], 'status', 'cancelled');
----
firestore_update_batch: 'order2' is not a full document path

statement error
SELECT * FROM firestore_delete_batch('~orders', ['users/user1/orders/order1', 'users/user2']);
----
firestore_delete_batch: document 'users/user2' is in collection 'users', not in collection group '~orders'

# The group name is checked even when the list is empty or NULL
statement error
SELECT * FROM firestore_update_batch('~', []::VARCHAR[], 'status', 'active');
----
firestore_update_batch: collection group '~' names no collection

statement error
SELECT * FROM firestore_delete_batch('~users/user1/orders', NULL::VARCHAR[]);
----
firestore_delete_batch: collection group '~users/user1/orders' is a path

# Array transforms
statement error
SELECT * FROM firestore_array_union('~orders', 'order1', 'tags', ['urgent']);
----
firestore_array_union: 'order1' is not a full document path

statement error
SELECT * FROM firestore_array_remove('~orders', 'users/user1', 'tags', ['urgent']);
----
firestore_array_remove: document 'users/user1' is in collection 'users', not in collection group '~orders'

statement error
SELECT * FROM firestore_array_append('~orders', 'users/user1/profile/main', 'tags', ['urgent']);
----
firestore_array_append: document 'users/user1/profile/main' is in collection 'profile'

# The check needs no credentials: it fails the same way without a secret
statement ok
DROP SECRET type_test;

statement error
SELECT * FROM firestore_delete('~orders', 'users/user1');
----
firestore_delete: document 'users/user1' is in collection 'users'

statement ok
CREATE SECRET type_test (
    TYPE firestore,
    PROJECT_ID 'test-project',
    API_KEY 'test-key'
);

# Empty list with ~ prefix returns 0 (no documents to process)
query I
SELECT * FROM firestore_update_batch('~orders', []::VARCHAR[], 'status', 'active');
----
0

# Empty list for delete with ~ prefix returns 0
query I
SELECT * FROM firestore_delete_batch('~orders', []::VARCHAR[]);
----
0

# Clean up
statement ok
DROP SECRET type_test;
